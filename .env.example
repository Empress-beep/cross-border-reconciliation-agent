# ===== 跨境对账系统 v2.0 配置模板 =====
# 使用：复制本文件为 .env 后填写（copy .env.example .env）
# 全部留空也能运行——AI 功能自动降级/隐藏，对账与下载不受影响

# ---- 内置AI差异归因（千问 / DashScope，可选）----
# 百炼控制台创建 API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# 业务空间ID（新版千问调用需要；留空则用代码内置默认值）
DASHSCOPE_WORKSPACE_ID=

# ---- Agent 聊天面板（FastGPT，可选，三项齐全才显示聊天框）----
# API 根地址（填主机根 https://cloud.fastgpt.cn 或 .../api 均可，自动归一）
FASTGPT_BASE_URL=
# 密钥：发布渠道 → API 访问 → 新建（fastgpt- 开头）
FASTGPT_API_KEY=
# 应用ID：发布渠道 → 免登录窗口，链接中 appId=xxx 的值
FASTGPT_APP_ID=
