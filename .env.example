# ===== 跨境对账系统 v2.0 配置模板 =====
# 使用：复制本文件为 .env 后填写（copy .env.example .env）
# 必需：MySQL 与 Redis（任务表 + 队列，系统启动前置条件，见 docs/部署手册.md）
# 可选：AI 两项留空则自动降级（对账、下载、历史均不受影响）

# ---- MySQL（必需：任务元数据表）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=reconcile_agent

# ---- Redis + RQ 队列（必需：任务队列）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
QUEUE_NAME=reconcile
# worker 由 Web 进程自动拉起与守护；分布式部署设为 off 并手动运行：
#   python -m service.worker_main
RECONCILE_WORKER=auto

# ---- 内置AI差异归因（千问 / DashScope，可选）----
# 百炼控制台创建 API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# 业务空间ID（新版千问调用需要；留空则调用不携带 workspace_id）
DASHSCOPE_WORKSPACE_ID=

# ---- Agent 聊天面板（FastGPT，可选，三项齐全才显示聊天框）----
# API 根地址（填主机根 https://cloud.fastgpt.cn 或 .../api 均可，自动归一）
FASTGPT_BASE_URL=
# 密钥：发布渠道 → API 访问 → 新建（fastgpt- 开头）
FASTGPT_API_KEY=
# 应用ID：发布渠道 → 免登录窗口，链接中 appId=xxx 的值
FASTGPT_APP_ID=
